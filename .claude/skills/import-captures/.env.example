# import-captures skill -- per-machine config. Copy to `.env` (gitignored) and fill in.
# NONE of these paths are committed; .env stays out of git.

# Directory holding the accurate packet captures (*.pcap). External + gitignored.
# Either the dir of .pcap files, or a parent containing a captures/ subdir.
ENB_CAPS_DIR=/path/to/your/captures

# Scratch dir for decoded + aggregated JSON (recreated freely; safe to delete).
ENB_IMPORT_WORK=/tmp/enb-import-captures

# Running Postgres container name (docker compose default shown).
ENB_PG_CONTAINER=freya-postgres-1
