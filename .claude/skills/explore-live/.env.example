# explore-live skill config -- copy to .env (gitignored) and fill in.
#   cp .claude/skills/explore-live/.env.example .claude/skills/explore-live/.env
#
# This holds the per-machine values the live/attach survey needs: the account to
# log in, the character to fly, where the survey state lives, and (for crash
# recovery) where the real Net-7 launcher is. .env is gitignored -- never commit it.

# ---- account (fed to enbmod autologin; the client logs ITSELF in, no OCR) ----
# enbmod's autologin reads these from the client process environment. recover.sh
# exports them onto LaunchNet7 so the client.exe it spawns inherits them.
ENB_ACC_NAME=devuser
ENB_ACC_PASS=devpass
ENB_CHARACTER=YourCharacterName
# EULA auto-accept for a fresh client (autologin clicks it). ACCEPT or leave blank.
ENB_EULA=ACCEPT

# ---- survey state (persistent, OUTSIDE the repo) ----------------------------
# Ledgers + action log + captures live here; a re-run resumes from it.
ENB_EXPLORE_WORKDIR=/path/outside/repo/enb-live-survey

# ---- WINE prefix + launcher (for crash recovery / initial bring-up) ---------
# The WINE prefix holding the EnB install. Leave blank to auto-detect from a
# running client, falling back to $HOME/.wine-enb.
#ENB_WINEPREFIX=

# Path to the real Net-7 launcher. Defaults to the standard location inside the
# WINE prefix ($ENB_WINEPREFIX/drive_c/Program Files (x86)/Net-7/bin/LaunchNet7.exe);
# set it here only if yours is elsewhere. recover.sh launches this and clicks Play
# to re-drive login + attachment after a crash.
#ENB_LAUNCHNET7=

# Fallback only. Recovery presses Play with the 'p' accelerator key (no coordinate
# needed, verified). Set this window-relative "x,y" of the Play button ONLY if 'p'
# does not start the client on your setup; otherwise leave it blank.
#ENB_LAUNCHNET7_PLAY_XY=

# ---- optional overrides -----------------------------------------------------
# Proxy process to treat as LIVE (WINE). Default Net7Proxy.exe; a running docker
# net7proxy is auto-detected as a LOCAL run and disables capture.
#ENB_EXPLORE_PROXY_NAME=Net7Proxy.exe
# Per-sector packet capture (LIVE server only; auto-forced 0 on a local run).
#ENB_PCAP=1
# Explicit enbmod store dir (skip /proc-cwd autodetect). Rarely needed.
#ENB_CLIENT_DIR=
# Survey tuning (see explore-sector/.env.example / drive_lua.py for the full set).
#ENB_MAX_SECTORS=40
#ENB_LUA_HANG_SECS=150
