<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window pops up next to the
         launcher on Windows. On Linux the subsystem flag is irrelevant and
         `dotnet run` still prints to the terminal. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>LaunchFreya</RootNamespace>
    <AssemblyName>FreyaLauncher</AssemblyName>
  </PropertyGroup>

  <!-- When building/publishing for a Windows RID (the standalone package via
       `just package-client-windows`, which passes -r win-x64), compile the
       HKLM registry-patch path IN and pull the Microsoft.Win32.Registry
       package. Without this, WindowsRegistryHelpers.EnsureRegistered() falls
       to its #else and throws PlatformNotSupportedException on EVERY launch,
       i.e. the shipped Windows build had the registry patch stripped out and
       "Play" always failed with "Could not patch registry-settings". Linux dev
       builds (no RID) deliberately leave it out; PatchRegistry only calls it
       when RuntimeInformation.IsOSPlatform(Windows), so it is never reached.
       (Single hyphens only in here: XML comments reject a double hyphen.) -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <DefineConstants>$(DefineConstants);WINDOWS_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- Phase AN self-updater gate. The shipped Windows package (built with
       -r win-x64 via `just package-client-windows`) checks for updates; a local
       `just play-local` / `dotnet run` build does NOT (no auth host to phone,
       and the dev exe layout has no bin/FreyaProxy.exe to hash). Default follows
       the win RID but is overridable, so the updater can be exercised locally
       against a stub: `dotnet run -p:CheckForUpdates=true`. (Single hyphens only
       in this comment: XML rejects a double hyphen.) -->
  <PropertyGroup>
    <CheckForUpdates Condition="'$(CheckForUpdates)' == '' and $(RuntimeIdentifier.StartsWith('win'))">true</CheckForUpdates>
    <CheckForUpdates Condition="'$(CheckForUpdates)' == ''">false</CheckForUpdates>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CheckForUpdates)' == 'true'">
    <DefineConstants>$(DefineConstants);CHECK_FOR_UPDATES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="FreyaLauncher.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.2.0" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <!-- See note in toolspatcher-avalonia/csproj. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>
