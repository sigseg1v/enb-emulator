<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="LaunchFreya.MainWindow"
        Width="1280" Height="820"
        Title="Freya Launcher"
        FontFamily="{StaticResource FreyaBodyFont}"
        CanResize="True">

  <!-- Deep-space backdrop: a vertical void gradient, matching the website
       body background (the dark blue void tokens). -->
  <Window.Background>
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FF060B16" />
      <GradientStop Offset="1" Color="#FF030610" />
    </LinearGradientBrush>
  </Window.Background>

  <DockPanel Margin="18">

    <!-- Wordmark heading (mirrors the website wordmark): geometric tracked
         "FREYA" with an orbit ring, and a wide-spaced accent subtitle. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="2,0,0,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="FREYA" Classes="wordmark" FontSize="40" />
        <!-- orbit ring -->
        <Border Width="13" Height="13" CornerRadius="7" Margin="9,4,0,0"
                VerticalAlignment="Center" Background="Transparent"
                BorderBrush="{StaticResource FreyaAccentBrush}" BorderThickness="1.5"
                Opacity="0.6" BoxShadow="0 0 9 0 #5943DBEA" />
      </StackPanel>
      <TextBlock Text="ONLINE" Classes="wordmarkSub" Margin="3,7,0,0" />
    </StackPanel>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

    <!-- Row 0: Server picker (emulator/host) -->
    <Border Grid.Row="0" Classes="panel">
      <Grid ColumnDefinitions="100,*,100,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Emulator:" Classes="label" VerticalAlignment="Center" />
        <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Name="c_ComboBox_Emulators"
                   HorizontalAlignment="Stretch"
                   SelectionChanged="OnEmulatorsChanged" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server:" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0" />
        <!-- Editable: a user can type their own server URL, or pick a known one
             from the dropdown. The typed text is the source of truth. -->
        <AutoCompleteBox Grid.Row="1" Grid.Column="1" Name="c_ComboBox_Servers"
                         Margin="0,8,8,0" HorizontalAlignment="Stretch"
                         Watermark="server hostname or URL"
                         FilterMode="Contains" MinimumPrefixLength="0"
                         TextChanged="OnServerTextChanged"
                         SelectionChanged="OnServerSelected"
                         LostFocus="OnServerCommitted" />

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Status:" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="3" Name="c_ServerStatus"
                   Margin="0,8,0,0" VerticalAlignment="Center" Text="" FontWeight="Bold" />

        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,8,0,0" Spacing="12">
          <!-- Opens the Freya Online website. URL is derived from the selected
               server: localhost/127.0.0.1 -> the play-local dev site over HTTP
               (http://localhost:8088); any other host -> https://<host>, which
               is the live freya-online TLS endpoint (:443). -->
          <Button Name="c_Button_Website" Content="Website" Click="OnWebsiteClick" />
          <Button Name="c_Button_Check" Content="Check" Click="OnCheckClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Row 1: Profile (between the server section and the client section) -->
    <Border Grid.Row="1" Classes="panel" Margin="0,8,0,0">
      <Grid ColumnDefinitions="100,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Profile:" Classes="label" VerticalAlignment="Center" />
        <ComboBox  Grid.Column="1" Name="c_ComboBox_Profiles" HorizontalAlignment="Stretch"
                   SelectionChanged="OnProfileChanged" />
        <Button    Grid.Column="2" Margin="8,0,0,0" Width="36" Content="+"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   Name="c_Button_AddProfile" Click="OnAddProfileClick"
                   ToolTip.Tip="Create a new profile (copies the current settings)." />
        <Button    Grid.Column="3" Margin="8,0,0,0" Width="36" Content="X"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   Name="c_Button_DelProfile" Click="OnDeleteProfileClick"
                   ToolTip.Tip="Delete the selected profile. The Default profile cannot be deleted." />
      </Grid>
    </Border>

    <!-- Row 2: Client path + display settings + optional login -->
    <Border Grid.Row="2" Classes="panel" Margin="0,8,0,0">
      <Grid ColumnDefinitions="100,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Client EXE:" Classes="label" VerticalAlignment="Center" />
        <TextBox   Grid.Row="0" Grid.Column="1" Name="c_TextBox_Client" />
        <Button    Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Content="Browse..." Click="OnBrowseClient" />

        <!-- Display (BA-4) -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution:" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0" />
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <ComboBox Name="c_ComboBox_Resolution" Width="190" />
          <CheckBox Name="c_CheckBox_Fullscreen" Content="Fullscreen" VerticalAlignment="Center" />
          <CheckBox Name="c_CheckBox_LockMouse" Content="Lock Mouse to Window" VerticalAlignment="Center"
                    ToolTip.Tip="The game confines the mouse to its window while it has focus (its native behaviour). Untick to free the pointer so it can leave the window, e.g. to reach another client while multiboxing." />
        </StackPanel>

        <!-- Optional login (BA-5) + optional client-window placement. Window Pos:
             both blank -> leave the window where the game opens it; both set ->
             reposition to (X,Y) once it appears. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <TextBox Name="c_TextBox_Username" Width="190" Watermark="optional" />
          <TextBlock Text="Window Pos:" Classes="label" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="X" Classes="label" VerticalAlignment="Center" />
            <TextBox Name="c_TextBox_WindowX" Width="80" Watermark="optional"
                     ToolTip.Tip="Screen X to move the client window to after launch. Leave blank to leave it where the game opens it." />
            <TextBlock Text="Y" Classes="label" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox Name="c_TextBox_WindowY" Width="80" Watermark="optional"
                     ToolTip.Tip="Screen Y to move the client window to after launch. Leave blank to leave it where the game opens it." />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox   Grid.Row="3" Grid.Column="1" Name="c_TextBox_Password" Width="190"
                   HorizontalAlignment="Left" Margin="0,8,0,0" PasswordChar="*" Watermark="optional" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Character:" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox   Grid.Row="4" Grid.Column="1" Name="c_TextBox_Character" Width="190"
                   HorizontalAlignment="Left" Margin="0,8,0,0" Watermark="optional" />
      </Grid>
    </Border>

    <!-- Row 3: Authentication -->
    <Border Grid.Row="3" Classes="panel" Margin="0,8,0,0">
      <Grid ColumnDefinitions="220,*">
        <TextBlock Grid.Column="0" Text="Upstream Auth Port (TLS):" Classes="label" VerticalAlignment="Center" />
        <TextBox   Grid.Column="1" Name="c_TextBox_Port" Width="80" HorizontalAlignment="Left" />
      </Grid>
    </Border>

    <!-- Row 4: Options -->
    <Border Grid.Row="4" Classes="panel" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <CheckBox Name="c_CheckBox_LuaMods" Content="Enable Lua Mods (experimental)"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Inject the enbmod Lua runtime into the client so Lua scripts can add client-side UI mods. Experimental and unverified -- off by default." />
        <!-- Enabled only while Lua Mods is checked; opens the per-mod config popup. -->
        <Button Name="c_Button_ConfigureMods" Content="Configure Mods..."
                IsEnabled="{Binding #c_CheckBox_LuaMods.IsChecked}"
                Click="OnConfigureModsClick"
                ToolTip.Tip="Turn individual Lua mods on or off. Disabled mods are not staged or loaded." />
      </StackPanel>
    </Border>

    <!-- Row 5: Status line + (Phase AN) indeterminate update/download spinner -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" Margin="0,14,0,4">
      <TextBlock Name="c_Status" VerticalAlignment="Center"
                 Foreground="{StaticResource FreyaTextDimBrush}"
                 Text="Please select a server and hit Play." />
      <ProgressBar Name="c_UpdateSpinner" Width="160" IsIndeterminate="True"
                   IsVisible="False" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Row 6: filler so the button row hugs the bottom -->
    <Border Grid.Row="6" />

    <!-- Row 7: Buttons. The log pane is hidden; its contents are -->
    <!-- surfaced through the Advanced... dialog.                  -->
    <Grid Grid.Row="7">
      <TextBox Name="c_LogPane" IsVisible="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="c_Button_Advanced" Content="Advanced..." Click="OnAdvancedClick" />
        <Button Name="c_Button_Cancel"   Content="Quit"        Click="OnCancelClick"   IsCancel="True" />
        <Button Name="c_Button_Play"     Content="Play"        Click="OnPlayClick"     IsDefault="True" Classes="accent" />
      </StackPanel>
    </Grid>

  </Grid>
  </DockPanel>
</Window>
