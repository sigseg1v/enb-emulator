<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ItemEditor"
        x:Class="ItemEditor.MainWindow"
        Width="2200" Height="1520"
        Title="Item Editor"
        WindowStartupLocation="CenterScreen">
  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New"      Click="OnNewClick" />
        <MenuItem Header="_Copy Row" Click="OnNewFromClick" />
        <MenuItem Header="_Save"     Click="OnSaveClick" />
        <MenuItem Header="_Delete"   Click="OnDeleteClick" />
        <Separator />
        <MenuItem Header="_Export Changes to SQL..." Click="OnExportClick" />
        <Separator />
        <MenuItem Header="E_xit"     Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Refresh Table" Click="OnRefreshClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                Margin="6,4,6,0" Spacing="4">
      <Button Content="New"      Click="OnNewClick" />
      <Button Content="Copy Row" Click="OnNewFromClick" />
      <Button Content="Save"     Click="OnSaveClick" />
      <Button Content="Delete"   Click="OnDeleteClick" />
      <Border Width="1" Background="Gray" Margin="6,0" />
      <Button Content="Refresh"  Click="OnRefreshClick" />
      <Button Content="Export Changes..." Click="OnExportClick" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="6,2">
      <TextBlock Name="c_Status" Text="Ready" />
    </Border>

    <Grid ColumnDefinitions="420,4,*">

      <!-- Left pane: item list + name search -->
      <DockPanel Grid.Column="0" Margin="6">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
          <TextBox  Grid.Column="0" Name="c_SearchText"
                    Watermark="Search by name..." Margin="0,0,4,0" />
          <ComboBox Grid.Column="1" Name="c_SearchMode" Margin="0,0,4,0" />
          <Button   Grid.Column="2" Content="Search" Click="OnSearchClick" />
        </Grid>

        <DataGrid Name="c_ItemGrid" Margin="0,4,0,0"
                  x:DataType="local:ItemRow"
                  IsReadOnly="True" CanUserResizeColumns="True"
                  GridLinesVisibility="All"
                  SelectionMode="Single"
                  SelectionChanged="OnItemGridSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID"    Binding="{Binding ItemID}"   Width="80" />
            <DataGridTextColumn Header="Name"  Binding="{Binding Name}"     Width="*" />
            <DataGridTextColumn Header="Lvl"   Binding="{Binding Level}"    Width="50" />
            <DataGridTextColumn Header="Cat"   Binding="{Binding Category}" Width="50" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                    Background="Gray" HorizontalAlignment="Stretch" />

      <!-- Right pane: detail editor -->
      <ScrollViewer Grid.Column="2" Margin="4">
        <Grid Margin="8" ColumnDefinitions="140,*,140,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

          <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="0" Grid.Column="1" Name="c_IdText" IsReadOnly="True" Margin="0,4" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Name:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="0" Grid.Column="3" Name="c_NameText" Margin="0,4"
                     TextChanged="OnNameChanged" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Level:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="1" Grid.Column="1" Name="c_LevelText" Margin="0,4"
                     TextChanged="OnLevelChanged" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Type:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="1" Grid.Column="3" Name="c_TypeText" Margin="0,4" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="2" Grid.Column="1" Name="c_CategoryText" Margin="0,4"
                     TextChanged="OnCategoryChanged" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="Sub-category:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="2" Grid.Column="3" Name="c_SubCategoryText" Margin="0,4" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Max stack:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="3" Grid.Column="1" Name="c_MaxStackText" Margin="0,4" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="Price:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="3" Grid.Column="3" Name="c_PriceText" Margin="0,4" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Manufacturer:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="4" Grid.Column="1" Name="c_ManufacturerText" Margin="0,4" />
          <TextBlock Grid.Row="4" Grid.Column="2" Text="Effect id:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="4" Grid.Column="3" Name="c_EffectIdText" Margin="0,4" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="2D asset:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="5" Grid.Column="1" Name="c_Asset2dText" Margin="0,4" />
          <TextBlock Grid.Row="5" Grid.Column="2" Text="3D asset:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="5" Grid.Column="3" Name="c_Asset3dText" Margin="0,4" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Base item id:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="6" Grid.Column="1" Name="c_ItemBaseIdText" Margin="0,4" />
          <TextBlock Grid.Row="6" Grid.Column="2" Text="Status:" VerticalAlignment="Center" Margin="0,4" />
          <TextBox   Grid.Row="6" Grid.Column="3" Name="c_StatusText" Margin="0,4" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Flags:" VerticalAlignment="Top" Margin="0,8" />
          <WrapPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4">
            <CheckBox Name="c_NoTrade"   Content="No trade"   Margin="0,0,12,0" />
            <CheckBox Name="c_NoStore"   Content="No store"   Margin="0,0,12,0" />
            <CheckBox Name="c_NoDestroy" Content="No destroy" Margin="0,0,12,0" />
            <CheckBox Name="c_NoManu"    Content="No manu"    Margin="0,0,12,0" />
            <CheckBox Name="c_Unique"    Content="Unique"     Margin="0,0,12,0" />
            <CheckBox Name="c_CustomFlag" Content="Custom"    Margin="0,0,12,0" />
          </WrapPanel>

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,8" />
          <TextBox   Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Name="c_DescriptionText"
                     Margin="0,4" Height="120" AcceptsReturn="True" TextWrapping="Wrap" />
        </Grid>
      </ScrollViewer>
    </Grid>

  </DockPanel>
</Window>
