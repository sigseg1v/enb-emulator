<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="450"
        x:Class="ToolsLauncher.MainWindow"
        Title="Net7 Tools Launch Pad" Width="390" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="c_SettingsMnu" Header="Settings..." Click="OnSettings" />
        <Separator />
        <MenuItem x:Name="c_QuitMnu" Header="Quit" Click="OnQuit" />
      </MenuItem>
    </Menu>

    <StackPanel DockPanel.Dock="Bottom" Margin="6,6,6,16" Spacing="6">
      <Button x:Name="c_LaunchN7Btn" Classes="accent" Content="Launch Net7"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Click="OnLaunchNet7" />
      <Button x:Name="c_LaunchCliBtn" Classes="accent" Content="Launch Net7 CLI"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Click="OnLaunchNet7Cli" />
      <TextBlock x:Name="c_Status" HorizontalAlignment="Center"
                 Foreground="Gray" Text="" />
    </StackPanel>

    <StackPanel Margin="6" Spacing="6" x:Name="c_EditorStack" />
  </DockPanel>
</Window>
