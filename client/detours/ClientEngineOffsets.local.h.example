//==============================================================================
// ClientEngineOffsets.local.h.example
//
// TEMPLATE for the PB-2 MVAS position-feed engine read (the OWNER SEAM).
//
// Copy this file to  ClientEngineOffsets.local.h  (same directory) and fill in
// the body for YOUR client build. The copy is gitignored on purpose: it carries
// build-specific, version-specific values that MUST NOT be committed (see
// CLAUDE.md and ClientPositionFeed.h). This .example carries NONE of them -- it
// is the contract only, with the read left returning false so an un-filled tree
// keeps the feed inert.
//
// Contract: define ONE function,
//
//     static bool Net7ReadEngineShipState_Local(
//         float pos[3], float heading[3], unsigned int *sector);
//
// returning the ship's current world position (x,y,z) and orientation (x,y,z)
// and the current sector id, or false whenever there is no live in-space sample
// (loading screen, docked, char-select). ClientPositionFeed.cpp's seam picks
// this up automatically when the local header is present (__has_include).
//
// The publisher runs inside client.exe, so the read is IN-PROCESS: dereference
// the engine's live ship-transform directly -- there is no cross-process
// ReadProcessMemory and no process handle to open. The transform is a row-major
// 3x4 affine matrix (three 16-byte rows of [3 orientation floats][1 translation
// float]); the translation column is the world position and the first column is
// a usable heading. Obtain the live base pointer the way your build exposes it
// (the in-process equivalent of capturing the first object through the transform
// loop). Keep every literal value local to the copied file.
//==============================================================================
#ifndef _NET7_CLIENT_ENGINE_OFFSETS_LOCAL_H_
#define _NET7_CLIENT_ENGINE_OFFSETS_LOCAL_H_

static bool Net7ReadEngineShipState_Local(float pos[3], float heading[3],
                                          unsigned int *sector)
{
    // TODO(owner, local copy only): fill for the client build in use. Leaving it
    // false keeps the feed inert (the committed default). See the recipe handed
    // over out-of-band; do not paste build-specific addresses into a tracked file.
    (void) pos;
    (void) heading;
    (void) sector;
    return false;
}

#endif // _NET7_CLIENT_ENGINE_OFFSETS_LOCAL_H_
