# Secrets + per-operator config
.env
backend.hcl

# Issued certs (LE leaf/key written by terraform's acme resource)
certs-prod/

# Terraform local working dir + any stray local state (state is in S3)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Deploy bundle scratch
*.tgz

backup/

# Operator-supplied client patch payloads (enb-patch.exe ~200MB), the operator's
# own patch notes (enb-patch-readme.md), and the generated local hash record
# (manifest.json). All per-operator -- the dir is kept via .gitkeep so there is a
# place to drop the patch, but those contents never commit. patches/reference/ is
# kept IN git (documentation reference deltas, not a deliverable patch).
patches/*
!patches/.gitkeep
!patches/reference
!patches/reference/**