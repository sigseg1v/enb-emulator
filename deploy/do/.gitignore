# Secrets + per-operator config
.env
backend.hcl

# Issued certs (LE leaf/key written by terraform's acme resource)
certs-prod/

# Terraform local working dir + any stray local state (state is in S3)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Deploy bundle scratch
*.tgz

backup/

# Operator-supplied client patch payload (enb-patch.exe ~200MB) and the generated
# local hash record (manifest.json) are per-operator and never commit. The dir is
# kept via .gitkeep so there is a place to drop the patch. enb-patch-readme.md
# (what the patch must contain) and patches/reference/ (documentation reference
# deltas) ARE kept in git as documentation -- they are not a deliverable patch.
patches/*
!patches/.gitkeep
!patches/enb-patch-readme.md
!patches/reference
!patches/reference/**