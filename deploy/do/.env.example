# Copy to .env and fill in. .env is gitignored -- never commit it.
# Scripts read these; terraform receives them as TF_VAR_* (see _Common.ps1).

# ---- DigitalOcean ----
DO_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REGISTRY_NAME=enb-emulator            # globally unique DOCR name
REGISTRY_TIER=starter                 # free: 1 repo, 500MiB. We use ONE repo ("enb"), so this fits.
DROPLET_REGION=nyc3
DROPLET_SIZE=s-1vcpu-2gb              # 2GB = dev floor (~1.5GB idle); use s-2vcpu-4gb for public play
DROPLET_IMAGE=ubuntu-24-04-x64       # plain Ubuntu LTS; cloud-init installs docker (DO has no 26.04 image yet)
PROJECT_NAME=freya                   # docker compose project (container/volume/network namespace)

# ---- Domain (AWS Route53) ----
DOMAIN_NAME=enb.sigsegv.land
ROUTE53_ZONE_ID=Z0XXXXXXXXXXXXXXXXXXX  # the hosted zone that owns DOMAIN_NAME
# AWS auth is via a configured AWS CLI v2 profile (in ~/.aws) -- no standing
# keys in .env. The aws provider, the S3 state backend, and the bootstrap CLI
# all honor AWS_PROFILE. With MANAGE_CERT=true the profile needs Route53 on
# your zone PLUS iam:CreateUser / CreateAccessKey / PutUserPolicy (+ the Delete*
# variants for teardown), because Terraform mints the scoped, route53-only
# cert-renew user the droplet uses for autonomous renewal. With
# MANAGE_CERT=false a Route53-only profile is enough (you supply the cert).
AWS_PROFILE=your-cli-profile
AWS_REGION=us-east-1

# If true, Terraform creates the Route53 A record for you (zero manual steps).
# Set false to point DNS yourself -- the scripts print the reserved IP to use.
MANAGE_DNS=true

# ---- TLS / Let's Encrypt ----
# If true, Terraform issues + renews the cert via Route53 DNS-01.
MANAGE_CERT=true
ACME_EMAIL=you@example.com
# Use the staging directory while testing to avoid LE rate limits:
# ACME_SERVER_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_SERVER_URL=https://acme-v02.api.letsencrypt.org/directory

# ---- SSH (the operator's key; injected into the droplet) ----
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_ALLOWED_CIDR=0.0.0.0/0            # lock to YOUR.IP/32 in production

# ---- Terraform remote state (S3) ----
TFSTATE_BUCKET=your-name-enb-tfstate  # globally unique S3 bucket
TFSTATE_REGION=us-east-1
TFSTATE_KEY=enb/terraform.tfstate

# ---- Image version (optional) ----
# The server-side services share one repo ("enb") with per-service version tags
# (enb:server-vN / login-vN / status-notifier-vN / db-backup-vN) plus -latest.
# (The proxy is client-side and never pushed here.) Leave blank: `just push`
# auto-increments to the next vN and re-points -latest; `just update` runs
# -latest. Pin a specific release by setting this to a version suffix, e.g.
# IMAGE_TAG=v7, to run enb:{server,login,status-notifier,db-backup}-v7.
IMAGE_TAG=

# ---- External status events / status-notifier sidecar (optional, Phase AM) ----
# A Discord bot relays login/logout/level-up/broadcast/server-start lines into a
# channel and serves the /status + /notify slash commands. See
# docs/18-external-status-events.md. Default OFF: leave these blank and the
# server enqueues nothing and the sidecar idles. `just update` threads these into
# the droplet .env, so set them HERE (not by hand on the droplet -- that gets
# clobbered on the next deploy).
# Set to 1 to make the server enqueue events:
NET7_EXTERNAL_STATUS_ENABLED=
# SECRET -- the Discord bot token, the sidecar's single Discord touchpoint. The
# bot posts each event line into a channel AND answers the /status (read-only:
# players online with class, C/E/T levels, sector; sector count; uptime) and
# /notify (admin-only relay toggles) slash commands -- all READ-ONLY or
# sidecar-side, no path into the game server. The bot connects OUTBOUND to
# Discord's gateway (no inbound port). Empty => the whole sidecar idles. Never
# commit a real value (this .env is gitignored, like DO_TOKEN).
DISCORD_BOT_TOKEN=
# Optional -- register the slash commands to this one guild id for instant
# availability. Empty registers globally (first propagation can take up to ~1h).
DISCORD_GUILD_ID=
# The channel id the relay posts each event line into. Empty => the bot still
# serves /status + /notify but the relay is idle (no target channel).
STATUS_CHANNEL_ID=
# Delivered outbox rows older than this many days are swept hourly (0 disables).
STATUS_RETENTION_DAYS=7

# ---- FreyaLauncher self-update delivery (optional, Phase AN) ----
# The Windows FreyaLauncher SHA-512s its own FreyaLauncher.exe + FreyaProxy.exe
# at startup and POSTs both to the login server's /updateCheck; the login server
# answers from a manifest.json served (credential-free) over CloudFront, and the
# launcher self-replaces any changed file from the same host. Default OFF: leave
# ENB_PATCHER_PRIVATE_S3_BUCKET BLANK and the whole patcher stack stays inert
# (terraform creates no S3/CloudFront/ACM/WAF, and /updateCheck fail-closes to
# DOWN). See deploy README "launcher self-update".
#
# Opt in by setting the bucket name. This makes TF_VAR_manage_patcher=true, so
# `just up` then stands up: a PRIVATE S3 bucket, a CloudFront distro fronting it
# (OAC, no public S3), an ACM cert + Route53 dl.<domain>, and one per-IP WAF rate
# rule. Afterward `just push-client` uploads the launcher build + manifest.json.
# Globally-unique S3 bucket name (PRIVATE -- only CloudFront reads it):
ENB_PATCHER_PRIVATE_S3_BUCKET=
# Hostname the launcher/login fetch from. Empty => dl.<DOMAIN_NAME>. Must be in
# the Route53 zone above (terraform creates the A/AAAA alias to CloudFront).
PATCHER_DL_DOMAIN=
# Per-source-IP request cap over a rolling 5-min window (WAF blocks above this).
# A normal update is 1 manifest GET + up to 3 file GETs; 20 absorbs retries.
PATCHER_RATE_LIMIT=20

# ---- Rolling Postgres -> private S3 backups (optional, Phase AP) ----
# The db-backup sidecar dumps net7 + net7_user hourly with `pg_dump -Fc` and
# rolls them into a PRIVATE S3 bucket under flat hourly/ + daily/ prefixes:
# the newest 24 hourly dumps plus the newest 14 daily promotions, pruned BY
# COUNT (no time-based S3 expiry, so a stalled sidecar never drains the set).
# See db-backup/README.md. Default OFF: leave ENB_DB_BACKUP_S3_BUCKET BLANK and
# terraform creates no S3/IAM and the sidecar idles.
#
# Opt in by setting JUST the bucket name below. This makes
# TF_VAR_manage_db_backup=true, so `just up` stands up a PRIVATE S3 bucket + a
# BUCKET-SCOPED IAM user/token using your AWS profile. The token is NOT a secret
# you handle: terraform stores it in the tfstate, and `just update` reads it
# straight from the tf outputs and threads it into the droplet .env. There are no
# access-key/secret fields to paste here -- that is deliberate.
#
# Globally-unique S3 bucket name (PRIVATE -- never served to the internet):
ENB_DB_BACKUP_S3_BUCKET=
