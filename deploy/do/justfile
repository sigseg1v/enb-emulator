# DigitalOcean production deploy recipes. Run from deploy/do/:  just <recipe>
# This is a SEPARATE justfile from the repo-root one by design -- deploy
# commands are not mixed into the dev/build justfile.
set shell := ["pwsh", "-NoProfile", "-Command"]

# List recipes.
default:
    @just --list

# One-time: create the encrypted, versioned S3 bucket for terraform state.
bootstrap:
    ./scripts/Bootstrap-State.ps1

# Converge infra: droplet, reserved IP, firewall, registry, Route53 record,
# Let's Encrypt cert. Idempotent; also renews the cert. SAFE BY DEFAULT --
# `just up` only PRINTS the plan; `just up -y` actually applies it.
up *flags:
    ./scripts/Deploy-Infra.ps1 {{flags}}

# The proxy is client-side and never deployed here.
# Build + push the server-side images only (server/login/status-notifier/db-backup). Optional tag.
push-server tag="":
    ./scripts/Build-And-Push.ps1 -Tag "{{tag}}"

# Errors out unless the patcher is configured (ENB_PATCHER_PRIVATE_S3_BUCKET set
# + infra up). Run `just apply-update` afterward so login re-reads the manifest.
# (Phase AN, opt-in) Build + push the Windows client patch to the patcher bucket.
push-client:
    ./scripts/Push-ClientPatch.ps1

# The client step runs only when the patcher is configured; otherwise it is
# skipped with a notice (no bucket to push to). Does NOT ship to the droplet.
# Build + push BOTH the server images and the Windows client patch. Optional tag.
push tag="": (push-server tag)
    . ./scripts/_Common.ps1; Import-DeployEnv; if (Get-EnvOr 'ENB_PATCHER_PRIVATE_S3_BUCKET' '') { ./scripts/Push-ClientPatch.ps1 } else { Write-Host 'push: patcher not configured (ENB_PATCHER_PRIVATE_S3_BUCKET unset) -- skipping client patch. Run ''just push-client'' after enabling it.' }

# Does NOT build or push -- run after a `just push`, or use `just update` for the
# full build -> push -> ship in one shot.
# Ship config/certs/data + pull images + (re)start the stack on the droplet. Optional tag.
apply-update tag="":
    ./scripts/Update-Stack.ps1 -Tag "{{tag}}"

# Runs `just push` (server + client) then `just apply-update`.
# FULL end-to-end deploy of a new build -- THE one command to ship a build. Optional tag.
update tag="": (push tag) (apply-update tag)

# Start an already-deployed stack (no image pull).
start:
    ./scripts/Start-Stack.ps1

# Stop the stack; data + infra preserved.
stop:
    ./scripts/Stop-Stack.ps1

# Destroy ALL infra incl. the droplet + its DB volume. Asks for confirm.
destroy:
    ./scripts/Destroy-Infra.ps1 -Confirm

# ---- admin (over SSH to the droplet) ----

# Create a player account on the live droplet. Password is Argon2id-hashed
# locally (needs python3-nacl); refuses if the username already exists.
#   just create-account <username> <password>
create-account username password:
    ./tools/Create-Account.ps1 -Username "{{username}}" -Password "{{password}}"

# Show live status: container health/uptime, players online, sectors occupied.
get-server-status:
    ./tools/Get-ServerStatus.ps1
