#cloud-config
# Droplet bootstrap on a plain Ubuntu LTS base. runcmd installs docker + the
# compose plugin (the base image does NOT ship them); this also (a) installs
# the private-registry pull credentials, (b) prepares the /opt/enb deploy
# directory, and (c) -- when
# MANAGE_CERT is on -- installs an autonomous Let's Encrypt renewal timer so
# the cert does NOT depend on a workstation re-running terraform. The actual
# stack is shipped + started by scripts/Update-Stack.ps1.
write_files:
  - path: /root/.docker/config.json
    permissions: "0600"
    encoding: b64
    content: ${base64encode(docker_credentials)}
%{ if manage_cert ~}
  - path: /opt/enb/cert-renew/lego.env
    permissions: "0600"
    content: |
      DOMAIN=${domain_name}
      EMAIL=${acme_email}
      ACME_SERVER=${acme_server_url}
      AWS_REGION=${aws_region}
      AWS_HOSTED_ZONE_ID=${route53_zone_id}
      AWS_ACCESS_KEY_ID=${cert_renew_access_key}
      AWS_SECRET_ACCESS_KEY=${cert_renew_secret_key}
  - path: /opt/enb/cert-renew/renew.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      # Autonomous Let's Encrypt renewal on the droplet (lego via docker,
      # DNS-01 over Route53). Terraform ships the FIRST cert; this timer owns
      # ongoing renewal. lego revalidates (fresh DNS-01 challenge) on every
      # renewal -- that is inherent to ACME, not something we toggle.
      set -euo pipefail
      . /opt/enb/cert-renew/lego.env
      LEGO=/opt/enb/cert-renew/.lego
      CRT="$LEGO/certificates/$DOMAIN.crt"
      DST=/opt/enb/certs
      mkdir -p "$LEGO" "$DST"
      # First run for THIS account has no local cert -> issue; afterwards renew
      # only when inside 30 days of expiry (cheap to run daily).
      if [ -f "$CRT" ]; then ACTION=(renew --days 30 --no-random-sleep); else ACTION=(run); fi
      before=""; [ -f "$CRT" ] && before="$(sha256sum "$CRT" | cut -d' ' -f1)"
      docker run --rm \
        -e AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID" \
        -e AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY" \
        -e AWS_REGION="$AWS_REGION" \
        -e AWS_HOSTED_ZONE_ID="$AWS_HOSTED_ZONE_ID" \
        -v "$LEGO":/data \
        goacme/lego --accept-tos --email "$EMAIL" --server "$ACME_SERVER" \
        --dns route53 --domains "$DOMAIN" --path /data "$${ACTION[@]}"
      after="$(sha256sum "$CRT" | cut -d' ' -f1)"
      if [ "$before" = "$after" ]; then echo "cert unchanged; nothing to do"; exit 0; fi
      # New cert: hand it to the server under the names SSL_Listener.cpp loads,
      # then bounce ONLY the login container so it re-reads the cert at startup.
      install -m600 "$CRT" "$DST/$DOMAIN.cer"
      install -m600 "$LEGO/certificates/$DOMAIN.key" "$DST/$DOMAIN.pem"
      if [ -f /opt/enb/docker-compose.prod.yml ] && [ -f /opt/enb/.env ]; then
        cd /opt/enb
        docker compose --env-file .env -f docker-compose.prod.yml up -d --force-recreate login
        echo "cert renewed + login restarted"
      else
        echo "cert renewed (stack not deployed yet; login picks it up on next deploy)"
      fi
  - path: /etc/systemd/system/enb-cert-renew.service
    content: |
      [Unit]
      Description=Renew Earth & Beyond login TLS cert (lego / Route53 DNS-01)
      Wants=network-online.target docker.service
      After=network-online.target docker.service
      [Service]
      Type=oneshot
      ExecStart=/opt/enb/cert-renew/renew.sh
  - path: /etc/systemd/system/enb-cert-renew.timer
    content: |
      [Unit]
      Description=Daily Earth & Beyond TLS cert renewal check
      [Timer]
      OnCalendar=daily
      RandomizedDelaySec=3600
      Persistent=true
      [Install]
      WantedBy=timers.target
%{ endif ~}
  - path: /opt/enb/reserved-ip-snat.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      # DigitalOcean reserved (floating) IP egress fix.
      #
      # The reserved IP is delivered to the droplet via a private anchor IP on
      # eth0; the droplet ALSO has its own primary public IP, which is the
      # default route source. Inbound game UDP arrives on the reserved IP and is
      # DNAT'd into the server container, so conntrack-tracked REPLIES egress
      # correctly as the reserved IP. But packets the server INITIATES to a
      # client (the in-sector login-stage / MVAS position feed) have no inbound
      # conntrack entry, so docker's MASQUERADE sources them from the PRIMARY
      # public IP instead. The client is talking to the reserved IP, sees a
      # reply from a different address, and drops it -- the player then times out
      # at "login stage 3" and can never enter a sector.
      #
      # Fix: SNAT the compose bridge's public egress to the reserved-IP anchor,
      # inserted ahead of docker's MASQUERADE rule, so EVERY server->client
      # packet (initiated or reply) leaves as the reserved IP. Idempotent;
      # re-applied by a timer because docker rewrites POSTROUTING on restart and
      # the reserved IP may be assigned after first boot.
      set -euo pipefail
      ANCHOR="$(curl -s --max-time 4 http://169.254.169.254/metadata/v1/interfaces/public/0/anchor_ipv4/address || true)"
      if [ -z "$ANCHOR" ]; then echo "no anchor IP (reserved IP not assigned yet); skipping"; exit 0; fi
      # Discover the compose bridge subnet dynamically (br-* for the enb network);
      # fall back to docker's default-ish 172.18.0.0/16 if it cannot be found.
      SUBNET="$(docker network inspect $(docker network ls --filter name=enb -q) 2>/dev/null \
        | grep -oE '"Subnet": *"[0-9./]+"' | grep -oE '[0-9.]+/[0-9]+' | head -1)"
      SUBNET="$${SUBNET:-172.18.0.0/16}"
      if ! iptables -t nat -C POSTROUTING -s "$SUBNET" -o eth0 -j SNAT --to-source "$ANCHOR" 2>/dev/null; then
        iptables -t nat -I POSTROUTING 1 -s "$SUBNET" -o eth0 -j SNAT --to-source "$ANCHOR"
        echo "applied reserved-IP SNAT: $SUBNET -o eth0 -> $ANCHOR"
      else
        echo "reserved-IP SNAT already present: $SUBNET -> $ANCHOR"
      fi
  - path: /etc/systemd/system/enb-reserved-ip-snat.service
    content: |
      [Unit]
      Description=Source server->client UDP from the DO reserved IP (floating-IP egress fix)
      Wants=network-online.target docker.service
      After=network-online.target docker.service
      [Service]
      Type=oneshot
      ExecStart=/opt/enb/reserved-ip-snat.sh
  - path: /etc/systemd/system/enb-reserved-ip-snat.timer
    content: |
      [Unit]
      Description=Re-assert the reserved-IP SNAT rule (heals docker POSTROUTING rewrites)
      [Timer]
      OnBootSec=30
      OnUnitActiveSec=2min
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /opt/enb/db-backup.sh
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      # Logical Postgres backup: pg_dump both DBs every 6h to the host dir
      # /opt/enb/backups, keep the most recent 7 days. This guards against bad
      # migrations / accidental data loss / a corrupt pgdata volume. It does
      # NOT survive droplet loss (same disk) -- copy off-box if you need that.
      set -euo pipefail
      cd /opt/enb
      if [ ! -f docker-compose.prod.yml ] || [ ! -f .env ]; then
        echo "stack not deployed yet; skipping backup"; exit 0
      fi
      CID="$(docker compose --env-file .env -f docker-compose.prod.yml ps -q postgres || true)"
      if [ -z "$CID" ]; then echo "postgres not running; skipping backup"; exit 0; fi
      DIR=/opt/enb/backups
      mkdir -p "$DIR"
      ts="$(date +%Y%m%d-%H%M%S)"
      for db in net7 net7_user; do
        tmp="$DIR/$db-$ts.sql.gz.partial"
        out="$DIR/$db-$ts.sql.gz"
        # Use the container's own POSTGRES_USER/PASSWORD; pipefail aborts before
        # the mv if pg_dump fails, so a partial never gets promoted.
        docker exec "$CID" sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -U "$POSTGRES_USER" -d "$1"' _ "$db" | gzip > "$tmp"
        mv "$tmp" "$out"
        echo "wrote $out"
      done
      # Retention: keep only the most recent 7 days.
      find "$DIR" -name '*.sql.gz' -mtime +7 -delete
      find "$DIR" -name '*.partial' -mtime +1 -delete
      echo "backup complete: $ts"
  - path: /etc/systemd/system/enb-db-backup.service
    content: |
      [Unit]
      Description=Earth & Beyond Postgres backup (pg_dump -> /opt/enb/backups)
      Wants=docker.service
      After=docker.service
      [Service]
      Type=oneshot
      ExecStart=/opt/enb/db-backup.sh
  - path: /etc/systemd/system/enb-db-backup.timer
    content: |
      [Unit]
      Description=Earth & Beyond Postgres backup every 6h
      [Timer]
      OnCalendar=00/6:00:00
      RandomizedDelaySec=120
      Persistent=true
      [Install]
      WantedBy=timers.target

runcmd:
  # Swap FIRST, before the stack can start. The 2GB dev-floor droplet has no
  # swap, and the server's boot-time content load (all missions/sectors) spikes
  # the resident set past total RAM -- with no swap the kernel global-OOM-kills
  # net7 on every boot, crash-looping it (RestartCount climbs, UDP planes never
  # stay bound, clients cannot reach the char list). A 4GiB swapfile absorbs the
  # transient; swappiness=10 keeps steady-state off swap so latency is unharmed.
  # Idempotent: no-op if /swapfile already exists. Bump the droplet to >=4GB RAM
  # before real multiplayer load (see droplet_size in variables.tf).
  - bash -c 'test -e /swapfile || (fallocate -l 4G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile && (grep -q "^/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab))'
  - bash -c 'sysctl -w vm.swappiness=10 && (grep -q "^vm.swappiness" /etc/sysctl.conf || echo "vm.swappiness=10" >> /etc/sysctl.conf)'
  - mkdir -p /opt/enb/certs /opt/enb/db /opt/enb/server-data /opt/enb/backups
  # Install docker + compose plugin. The plain Ubuntu base ships neither; the
  # `command -v` guard makes this a no-op if a Docker-preloaded image is used.
  - bash -c 'command -v docker >/dev/null 2>&1 || curl -fsSL https://get.docker.com | sh'
  - bash -c 'docker compose version >/dev/null 2>&1 || (apt-get update && apt-get install -y docker-compose-plugin)'
  - systemctl enable --now docker
  - systemctl daemon-reload
  - systemctl enable --now enb-db-backup.timer
  - systemctl enable --now enb-reserved-ip-snat.timer
%{ if manage_cert ~}
  - systemctl enable --now enb-cert-renew.timer
%{ endif ~}
