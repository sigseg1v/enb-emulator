# Logs
*.log

# ----- Re-includes (`!` rules) for kept files that the patterns above would otherwise eat -----

# Vendor binaries we don't have source for — see THIRD_PARTY_BINARIES.md notes
!vendor/**

# Third-party libs vendored with the server build (we keep prebuilt artefacts for Windows builds)
!server/third_party/**
!server/src/LUA/**/*.lib

# login-server vendored mysql lib
!login-server/Net7Mysql/libmySQL.lib

# Modded client + auth dll (game binary, no source)
!client/mods/release/**

# Game data files (mixfiles, .bik video, etc.) shipped with the mods
!client/mods/Data/**

# C# tool resources (icons, images, sprites) often live under bin/ or with .dll extension
!tools/**/Resources/**
!tools/**/Images/**
!tools/**/Sprites/**
!tools/**/Props/**
!tools/**/Design/**

# C# tool vendored dependencies (DLLs they ship with — old MySql.Data, log4net, SandDock, etc.)
!tools/**/Libs/**
!tools/**/lib/**
!tools/**/*.dll
!tools/**/SQLBind/**

# Game-asset binaries from kyp's tooling
!archive/kyp-snapshot/**

# Derived from capture-extract runs (regenerable from archive/kyp-snapshot/capturedPackets/)
archive/replay/

# Original packet captures
!**/capturedPackets/**

# Reference docs (rtf, pdf, doc, ico, icns)
!**/*.rtf
!**/*.pdf
!**/*.doc
!**/*.ico
!**/*.ICO
!**/*.icns

# Per-rule: still EXCLUDE genuine build outputs inside the re-included paths
client/mods/release/*.tmp
tools/**/obj/

# Original Westwood/EA copyrighted binaries: removed and must never be re-added
# (see client/mods/THIRD_PARTY_BINARIES.md). These override the !-reincludes above.
client/mods/release/client.exe
*.bik
tools/**/bin/
server/**/build/
server/src/Debug/
server/src/Release/

# Proxy Win32 cross-build (rebuilt from source — see plans/23-phase-w-proxy-win32-crossbuild.md)
proxy/build-win64/
proxy/third_party/openssl-3.0.16/
proxy/third_party/openssl-3.0.16.tar.gz
proxy/third_party/openssl-mingw64/

# Dev SSL material — regenerated by `just gen-certs`; never commit private keys.
deploy/certs/*.pem
deploy/certs/*.cer
deploy/certs/*.key
deploy/certs/*.crt

# Local-only scratch space. Never committed.
/scratch/

# Python bytecode (import tooling under tools/dataimport-jsonl/ etc.)
__pycache__/
*.pyc

# Go build artifact for the status-notifier sidecar (rebuilt by `go build` /
# the Dockerfile). Source-only in git; never commit the compiled binary.
/freya/status-notifier/status-notifier

# Imported Claude Design bundle for Freya Online -- reference material only
# (contains PNG screenshots/box art; reconstructable from the design source).
# Our own ported, typed SPA lives in freya/online/web/ and IS committed.
/freya/online/design/

# Freya Online web SPA build output + deps
/freya/online/web/node_modules/
/freya/online/web/dist/

# Freya Online: locally-built Go binary (built in Docker for deploy)
freya/online/server/freya-online

# net7go: locally-built Go game-auth binary (built in Docker for deploy)
login-server/net7go/net7go
