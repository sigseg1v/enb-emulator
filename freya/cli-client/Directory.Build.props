<Project>
  <!--
    The CLI client is Linux-first, cross-platform, no WinForms / GDI+ (unlike the
    inherited WinForms tooling under tools/). It lives under freya/ as new MIT code
    and inherits no parent Directory.Build.props, so every property it needs is set
    explicitly here.
  -->
  <PropertyGroup>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes)</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Phase AT: StyleCop.Analyzers. SA* severities live in the repo-root
    .editorconfig at `suggestion`, so they guide the IDE / dotnet format
    without surfacing as warnings, which keeps TreatWarningsAsErrors green.
  -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../../stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
