<Project>
  <!--
    Integration tests are Linux-first, cross-platform, no WinForms/GDI+.
    Mirror the cli-client Directory.Build.props so this project shares
    its hygiene (nullable, warnings-as-errors, no Windows-targeting).
  -->
  <PropertyGroup>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Phase AT: StyleCop.Analyzers (severities at `suggestion` via repo-root
       .editorconfig, so TreatWarningsAsErrors stays green). -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../../../../stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
