<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Westwood RSA + RC4 handshake primitives, kept in their own assembly,
    deliberately separate from the MIT freya/ tree. These are textbook
    RC4/RSA but were originally authored as ports of the Net-7 proxy crypto
    (proxy/WestwoodRSA.cpp, proxy/WestwoodRC4.cpp, proxy/Connection.cpp), so
    their licensing is ambiguous and they carry no per-file SPDX header. The
    freya/cli-client projects reference this assembly rather than embedding
    the sources, keeping the two licensing buckets cleanly separated.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>N7.CliClient.Net</RootNamespace>
    <AssemblyName>WestwoodCrypto</AssemblyName>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
